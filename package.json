{
  "name": "sc-copilot-mcp",
  "version": "2.1.0",
  "description": "Local, read-only Model Context Protocol server for Star Citizen: market, wiki, patch data. Fork of voidput/SCMCP.",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "ts-node src/index.ts",
    "lint": "eslint \"src/**/*.ts\"",
    "format": "prettier --write \"src/**/*.ts\"",
    "test": "vitest run",
    "audit:prod": "npm audit --omit=dev --audit-level=high",
    "probe": "node scripts/mcp-probe.mjs",
    "check:sources": "node scripts/check-sources.mjs",
    "install:claude": "node scripts/install-claude-desktop.mjs",
    "docs:tools": "node scripts/generate-tool-docs.mjs",
    "docs:coverage": "node scripts/generate-coverage-docs.mjs",
    "typecheck": "tsc --noEmit",
    "format:check": "prettier --check \"src/**/*.ts\"",
    "test:coverage": "vitest run --coverage",
    "golden:update": "node scripts/update-golden.mjs",
    "doctor": "node scripts/doctor.mjs",
    "check:docs": "node scripts/check-docs-safety.mjs",
    "check:page-size": "node scripts/check-page-size.mjs",
    "telemetry": "node scripts/telemetry.mjs",
    "check:telemetry-silence": "node scripts/check-no-telemetry-connection.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ms-spown/sc-copilot-mcp.git"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "star-citizen"
  ],
  "author": "",
  "license": "GPL-3.0-only",
  "bugs": {
    "url": "https://github.com/ms-spown/sc-copilot-mcp/issues"
  },
  "homepage": "https://github.com/ms-spown/sc-copilot-mcp#readme",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "axios": "^1.20.0",
    "dotenv": "^17.4.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^25.5.2",
    "eslint": "^10.2.0",
    "prettier": "^3.8.1",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.2",
    "typescript-eslint": "^8.58.0",
    "vitest": "^4.1.2"
  },
  "overrides": {
    "minimatch": "^11.0.1"
  },
  "engines": {
    "node": "^20.19.0 || ^22.13.0 || >=24.0.0"
  }
}
