[
  {
    "name": "sc_data_status",
    "inputSchema": {
      "type": "object",
      "properties": {}
    }
  },
  {
    "name": "sc_diff_versions",
    "inputSchema": {
      "type": "object",
      "properties": {
        "dataset": {
          "type": "string",
          "enum": [
            "ships",
            "ship-components",
            "fps-weapons",
            "ammo",
            "mining",
            "mining-spawns",
            "blueprints",
            "missions",
            "reputation",
            "containers",
            "starmap",
            "manufacturers",
            "wikelo-trades",
            "strings"
          ],
          "description": "Which dataset to diff. 'ship-components' covers ship weapons, shields, coolers, power plants, quantum drives and radars; 'strings' is the localisation table, useful for spotting renamed or newly added content."
        },
        "from_version": {
          "type": "string",
          "description": "Older version, e.g. '4.9' or a full build string like '4.9.0-LIVE.12344265'."
        },
        "to_version": {
          "type": "string",
          "description": "Newer version, e.g. '4.10'."
        },
        "collection": {
          "type": "string",
          "description": "Optional: which collection inside the dataset to diff. Defaults to the main one (e.g. 'weapons' for ship-components); pass 'shields', 'quantumDrives', 'radars' or 'missiles' to diff those instead."
        },
        "item_name": {
          "type": "string",
          "description": "Optional: restrict to entries matching this name or class name (e.g. 'AD5B', 'Mantis', 'Talon'). Returns field-level changes."
        },
        "limit": {
          "type": "number",
          "description": "Max entries listed per category in summary mode (default 50)."
        }
      },
      "required": [
        "dataset",
        "from_version",
        "to_version"
      ]
    }
  },
  {
    "name": "sc_fleet_get",
    "inputSchema": {
      "type": "object",
      "properties": {
        "origin": {
          "type": "string",
          "enum": [
            "pledge",
            "in_game"
          ],
          "description": "Only ships with this origin."
        },
        "enrich": {
          "type": "boolean",
          "description": "Add public stats to each ship (default true). false lists the file as is, with no network."
        }
      }
    }
  },
  {
    "name": "sc_fleet_remove",
    "inputSchema": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "description": "Name exactly as listed in the fleet (case does not matter)."
        },
        "origin": {
          "type": "string",
          "enum": [
            "pledge",
            "in_game"
          ],
          "description": "Needed only when the name exists under both origins."
        }
      },
      "required": [
        "name"
      ]
    }
  },
  {
    "name": "sc_fleet_upsert",
    "inputSchema": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "description": "Ship name, e.g. 'Drake Vulture' or 'C2 Hercules Starlifter'."
        },
        "origin": {
          "type": "string",
          "enum": [
            "pledge",
            "in_game"
          ],
          "description": "'pledge' for a ship bought with real money, 'in_game' for one bought with aUEC."
        },
        "notes": {
          "type": "string",
          "description": "Optional note, up to 500 characters (loadout idea, role, location)."
        }
      },
      "required": [
        "name",
        "origin"
      ]
    }
  },
  {
    "name": "sc_get_vocabulary",
    "inputSchema": {
      "type": "object",
      "properties": {
        "include_commodities": {
          "type": "boolean",
          "description": "Include tradeable commodity names from UEX Corp (default true)."
        },
        "include_manufacturers": {
          "type": "boolean",
          "description": "Include ship/vehicle manufacturer names from the Star Citizen Wiki (default true)."
        },
        "include_weapons": {
          "type": "boolean",
          "description": "Include FPS and ship weapon names, ~580 terms (default true)."
        },
        "include_attachments": {
          "type": "boolean",
          "description": "Include weapon attachment names (scopes, magazines, ...), ~106 terms (default true)."
        },
        "include_armor": {
          "type": "boolean",
          "description": "Include armor piece names, ~2400 terms including colour variants (default false)."
        },
        "include_clothes": {
          "type": "boolean",
          "description": "Include clothing item names, ~1900 terms including colour variants (default false)."
        },
        "include_components": {
          "type": "boolean",
          "description": "Include ship component names (shields, coolers, quantum drives, ...), ~3300 terms (default false)."
        },
        "limit": {
          "type": "number",
          "description": "Cap on locally extracted labels merged in (default 1000)."
        }
      }
    }
  },
  {
    "name": "sc_list_builds",
    "inputSchema": {
      "type": "object",
      "properties": {
        "limit": {
          "type": "number",
          "description": "How many builds to return (default 40, max 100)."
        }
      }
    }
  },
  {
    "name": "sc_local_datasets",
    "inputSchema": {
      "type": "object",
      "properties": {}
    }
  },
  {
    "name": "sc_log_recent_events",
    "inputSchema": {
      "type": "object",
      "properties": {
        "limit": {
          "type": "number",
          "description": "Events to return, the most recent ones (default 30, max 100)."
        },
        "types": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "session_start",
              "login_completed",
              "spawned",
              "session_end",
              "jurisdiction_entered",
              "zone_change",
              "mission_accepted",
              "mission_completed",
              "mission_ended",
              "objective_new",
              "objective_completed",
              "shop_purchase_requested",
              "shop_purchase_result",
              "insurance_claim_requested",
              "hangar_request_completed"
            ]
          },
          "description": "Only these event types."
        },
        "since_minutes": {
          "type": "number",
          "description": "Only events from the last N minutes (by the log's own clock, UTC)."
        },
        "session": {
          "type": "string",
          "enum": [
            "current",
            "previous"
          ],
          "description": "'current' = Game.log (default); 'previous' = newest file in logbackups."
        }
      }
    }
  },
  {
    "name": "sc_log_status",
    "inputSchema": {
      "type": "object",
      "properties": {}
    }
  },
  {
    "name": "sc_read_local_collection",
    "inputSchema": {
      "type": "object",
      "properties": {
        "dataset": {
          "type": "string",
          "description": "Dataset name, e.g. 'game-mining'."
        },
        "collection": {
          "type": "string",
          "description": "Collection within the dataset, e.g. 'oreSignatures'."
        },
        "offset": {
          "type": "number",
          "description": "Records to skip (default 0)."
        },
        "limit": {
          "type": "number",
          "description": "Records to return (default 25, max 200)."
        }
      },
      "required": [
        "dataset",
        "collection"
      ]
    }
  },
  {
    "name": "sc_search_local",
    "inputSchema": {
      "type": "object",
      "properties": {
        "dataset": {
          "type": "string",
          "description": "Dataset name, e.g. 'game-mining' or 'game-blueprints'. See sc_local_datasets."
        },
        "query": {
          "type": "string",
          "description": "Case-insensitive term to match against keys, names and record contents."
        },
        "collection": {
          "type": "string",
          "description": "Optional: restrict to one collection within the dataset."
        },
        "limit": {
          "type": "number",
          "description": "Max records to return (default 20)."
        }
      },
      "required": [
        "dataset",
        "query"
      ]
    }
  },
  {
    "name": "scmdb_changes",
    "inputSchema": {
      "type": "object",
      "properties": {
        "to": {
          "type": "string",
          "description": "Show the update that ends at a build whose name contains this text (e.g. '4.10.2'). Default: the newest."
        },
        "limit": {
          "type": "number",
          "description": "Examples per list (default 8, max 30)."
        },
        "channel": {
          "type": "string",
          "enum": [
            "live",
            "ptu"
          ],
          "description": "Game channel: 'live' (default) or 'ptu' (test build, may be absent). The build used is in provenance."
        }
      }
    }
  },
  {
    "name": "scmdb_search_crafting",
    "inputSchema": {
      "type": "object",
      "properties": {
        "query": {
          "type": "string",
          "description": "Words that must all appear in the product name, type or manufacturer."
        },
        "type": {
          "type": "string",
          "description": "Product type or gear class, e.g. 'weapons', 'armour', 'shield', 'mininglaser'."
        },
        "uses_resource": {
          "type": "string",
          "description": "Only blueprints whose recipe uses this resource or item (e.g. 'Titanium')."
        },
        "include_sources": {
          "type": "boolean",
          "description": "Also list the missions that can reward each blueprint (default true; false is faster on the first call)."
        },
        "limit": {
          "type": "number",
          "description": "Rows to return (default 10, max 30)."
        },
        "channel": {
          "type": "string",
          "enum": [
            "live",
            "ptu"
          ],
          "description": "Game channel: 'live' (default) or 'ptu' (test build, may be absent). The build used is in provenance."
        }
      }
    }
  },
  {
    "name": "scmdb_search_mining",
    "inputSchema": {
      "type": "object",
      "properties": {
        "query": {
          "type": "string",
          "description": "Words that must all appear in the ore, laser or module name (e.g. 'quantanium', 'helix')."
        },
        "scope": {
          "type": "string",
          "enum": [
            "ores",
            "equipment",
            "all"
          ],
          "description": "What to search (default all)."
        },
        "limit": {
          "type": "number",
          "description": "Rows per section (default 8, max 30)."
        },
        "channel": {
          "type": "string",
          "enum": [
            "live",
            "ptu"
          ],
          "description": "Game channel: 'live' (default) or 'ptu' (test build, may be absent). The build used is in provenance."
        }
      }
    }
  },
  {
    "name": "scmdb_search_missions",
    "inputSchema": {
      "type": "object",
      "properties": {
        "query": {
          "type": "string",
          "description": "Words that must all appear in title, contractor, type, place or blueprint reward (e.g. 'wikelo', 'bounty pyro')."
        },
        "mission_type": {
          "type": "string",
          "description": "Part of the mission type (e.g. 'Hauling', 'Bounty Hunter', 'Salvage', 'Delivery')."
        },
        "category": {
          "type": "string",
          "enum": [
            "career",
            "story",
            "event"
          ],
          "description": "Mission category."
        },
        "faction": {
          "type": "string",
          "description": "Part of the contractor name (e.g. 'Headhunters')."
        },
        "location": {
          "type": "string",
          "description": "Place, planet, moon or star system the mission uses (e.g. 'Pyro', 'Hurston')."
        },
        "illegal": {
          "type": "boolean",
          "description": "true for illegal missions only, false to exclude them."
        },
        "min_reward": {
          "type": "number",
          "description": "Minimum reward in aUEC."
        },
        "reward_blueprint": {
          "type": "string",
          "description": "Part of the name of a blueprint the mission can reward."
        },
        "limit": {
          "type": "number",
          "description": "Rows to return (default 10, max 30)."
        },
        "channel": {
          "type": "string",
          "enum": [
            "live",
            "ptu"
          ],
          "description": "Game channel: 'live' (default) or 'ptu' (test build, may be absent). The build used is in provenance."
        }
      }
    }
  },
